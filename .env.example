# Local API uses SQLite by default. Docker Compose provides its PostgreSQL URL.
DATABASE_URL=sqlite:///./campusync.db

# Leave Stripe keys blank to use the built-in demo checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Change this before exposing the admin portal.
ADMIN_PIN=vortex2026

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173